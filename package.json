{
  "name": "business-monorepo",
  "version": "1.0.0",
  "description": "Indian-themed digital property-trading strategy board game for friends",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@business/web",
    "dev:server": "npm run dev --workspace=@business/server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
